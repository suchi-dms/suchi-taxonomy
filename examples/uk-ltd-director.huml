%HUML v0.2.0
format: "suchi-taxonomy/v1"
id: "uk-ltd-director"
version: 1
name: "UK limited-company director"
market: "uk"
language: "en"
license: "CC0-1.0"
story: "Keep statutory company records, tax submissions and director payment evidence apart from day-to-day banking and expenses. The categories describe documents, not customers, suppliers or successive accounting years."

areas::
  - ::
    code: 10
    name: "Company records"
    categories::
      - ::
        code: 11
        name: "Incorporation and statutory registers"
        description: "Incorporation certificates, articles and statutory register records."
      - ::
        code: 12
        name: "Confirmation statements"
        description: "Filed confirmation statements and Companies House acknowledgements."
      - ::
        code: 13
        name: "Contracts"
        description: "Executed client, supplier and other company agreements."
  - ::
    code: 20
    name: "Tax and remuneration"
    categories::
      - ::
        code: 21
        name: "Corporation tax"
        description: "Company tax returns, computations and payment evidence."
      - ::
        code: 22
        name: "VAT"
        description: "VAT returns, calculations and filing acknowledgements."
      - ::
        code: 23
        name: "PAYE and payroll"
        description: "Payroll submissions, payslips and employer payment records."
      - ::
        code: 24
        name: "Dividends"
        description: "Dividend vouchers and supporting board decisions."
  - ::
    code: 30
    name: "Banking and expenses"
    categories::
      - ::
        code: 31
        name: "Bank statements and reconciliations"
        description: "Company account statements and reconciliations; distinguish accounts with metadata."
      - ::
        code: 32
        name: "Expense invoices and receipts"
        description: "Supplier invoices and receipts supporting company expenditure."
      - ::
        code: 33
        name: "Director expense claims and loans"
        description: "Reimbursements, expense claims and director loan account evidence."
