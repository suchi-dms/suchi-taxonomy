format: "suchi-taxonomy/v1"
id: "in-landlord"
version: 1
name: "Indian residential landlord"
market: "in"
language: "en"
license: "CC0-1.0"
story: "Keep ownership papers, society correspondence and tenancy evidence in stable document-kind categories. Properties and tenants stay in correspondents so another letting does not require renumbering the archive."

areas::
  - ::
    code: 10
    name: "Property records"
    categories::
      - ::
        code: 11
        name: "Ownership and registry"
        description: "Conveyances, registration acknowledgements and ownership extracts."
        keywords:: "sale deed", "encumbrance certificate"
      - ::
        code: 12
        name: "Property tax"
        description: "Assessments and payment receipts for local property taxes."
        keywords:: "property tax receipt", "property tax assessment"
      - ::
        code: 13
        name: "Society and maintenance"
        description: "Society permissions, maintenance demands and repair records."
        keywords:: "society no objection certificate", "maintenance demand"
  - ::
    code: 20
    name: "Tenancy records"
    categories::
      - ::
        code: 21
        name: "Agreements"
        description: "Executed lease or leave-and-licence agreements and amendments."
        keywords:: "leave and license agreement", "residential lease agreement"
      - ::
        code: 22
        name: "Police verification and KYC"
        description: "Tenant verification acknowledgements and identity evidence; restrict access separately."
        keywords::
          - "tenant police verification"
      - ::
        code: 23
        name: "Rent receipts"
        description: "Issued rent receipts and rent-payment evidence."
        keywords::
          - "rent receipt"
