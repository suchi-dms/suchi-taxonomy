%HUML v0.2.0
format: "suchi-taxonomy/v1"
id: "us-small-landlord"
version: 1
name: "US small landlord"
market: "us"
language: "en"
license: "CC0-1.0"
story: "Keep deeds, insurance and repair evidence separate from leases, deposits and rental income records. Properties and tenants are correspondents; state and local requirements need separate review before relying on any document list."

areas::
  - ::
    code: 10
    name: "Property records"
    categories::
      - ::
        code: 11
        name: "Deeds and mortgage"
        description: "Recorded deeds, closing statements and mortgage records."
      - ::
        code: 12
        name: "Insurance"
        description: "Policy schedules, declarations and claim correspondence."
      - ::
        code: 13
        name: "Inspections and repairs"
        description: "Move-in condition reports, inspections and repair invoices."
  - ::
    code: 20
    name: "Tenancy records"
    categories::
      - ::
        code: 21
        name: "Leases"
        description: "Executed rental agreements and amendments."
      - ::
        code: 22
        name: "Deposits"
        description: "Deposit receipts, accounting statements and return evidence."
      - ::
        code: 23
        name: "Notices"
        description: "Served tenancy notices and delivery evidence."
  - ::
    code: 30
    name: "Rental money"
    categories::
      - ::
        code: 31
        name: "Rent ledgers"
        description: "Rental receipts, ledgers and property-manager statements."
      - ::
        code: 32
        name: "Tax records"
        description: "Schedule E, information returns and supporting tax computations."
