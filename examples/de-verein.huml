        name: "Gemeinnützigkeit"
        description: "Freistellungsbescheide und steuerliche Statusunterlagen."
      - ::
        code: 13
        name: "Vorstand und Protokolle"
        description: "Wahlunterlagen, Vorstands- und Mitgliederversammlungsprotokolle."
  - ::
    code: 20
    name: "Mitgliedschaft"
    categories::
      - ::
        code: 21
        name: "Aufnahme und Austritt"
        description: "Mitgliedsanträge, Aufnahmebestätigungen und Austrittserklärungen."
      - ::
        code: 22
        name: "Mitgliederverzeichnisse und Einwilligungen"
        description: "Mitgliederlisten und dokumentierte Einwilligungen; Zugriffe separat regeln."
      - ::
        code: 23
        name: "Beiträge und Mandate"
        description: "Beitragsbescheide, Zahlungsnachweise und Lastschriftmandate."
  - ::
    code: 30
