%HUML v0.2.0
format: "suchi-taxonomy/v1"
system: "S02"
id: "in-ca-firm-s02"
version: 1
name: "Sharma Advisory LLP"
market: "in"
language: "en"
license: "CC0-1.0"
story: "Keep client returns, audit working papers and signed engagements separate from the practice’s own finances and staff records. Identify clients with correspondents so new engagements do not require new categories."

areas::
  - ::
    code: 10
    name: "Client document kinds"
    categories::
      - ::
        code: 11
        name: "Engagement and KYC"
        description: "Signed engagement letters and identity checks; identify the client with correspondents."
      - ::
        code: 12
        name: "Income tax filings"
        description: "Client returns, acknowledgements, computation sheets and tax payment evidence."
      - ::
        code: 13
        name: "GST filings"
        description: "Client GST returns, reconciliations and acknowledgements."
      - ::
        code: 14
        name: "Audit and working papers"
        description: "Signed audit reports, evidence and working papers for each engagement."
      - ::
        code: 15
        name: "ROC and secretarial filings"
        description: "Company registry submissions, resolutions and filing acknowledgements."
      - ::
        code: 16
        name: "Certificates and UDIN"
        description: "Issued professional certificates and their UDIN acknowledgements."
  - ::
    code: 20
    name: "Practice money"
    categories::
      - ::
        code: 21
        name: "Fees and receivables"
        description: "Practice fee notes, collection records and receivable statements."
      - ::
        code: 22
        name: "Practice tax"
        description: "The practice’s own returns and tax computations, not client filings."
  - ::
    code: 30
    name: "Practice administration"
    categories::
      - ::
        code: 31
        name: "Registrations and membership"
        description: "Practice registrations, membership and certificates of practice."
      - ::
        code: 32
        name: "Staff and articles"
        description: "Employment, articleship registration and stipend records."
      - ::
        code: 33
        name: "Peer review"
        description: "Peer-review applications, evidence requests and issued reports."
